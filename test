}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){ --page:#10161b; --ink:#e7eef3; --muted:#91a2af; --panel:#1a2229; --line:#2b3843; --accent:#7ea6e6; }
}
:root[data-theme="dark"]{ --page:#10161b; --ink:#e7eef3; --muted:#91a2af; --panel:#1a2229; --line:#2b3843; --accent:#7ea6e6; }
html{ scroll-padding-top:env(safe-area-inset-top,0px); }
*,*::before,*::after{ box-sizing:inherit; }
body{ margin:0; background:var(--page); color:var(--ink); font-family:'Comic Neue','Comic Sans MS','Chalkboard SE',cursive,sans-serif; }
main{ max-width:1320px; margin:0 auto; padding:24px 20px 40px; }
h1{ font-size:clamp(1.6rem,3.2vw,2.3rem); margin:0 0 4px; font-weight:700; letter-spacing:-0.01em; }
.sub{ margin:0 0 18px; color:var(--muted); font-size:1.05rem; max-width:62ch; }
.stage{ position:relative; width:100%; aspect-ratio:16/9; background:#c3e7f8; border-radius:6px; overflow:hidden; border:2px solid var(--ink); }
canvas{ width:100%; height:100%; display:block; }
.caption{ min-height:3.2em; margin:14px 0 10px; font-size:clamp(1.05rem,2vw,1.35rem); line-height:1.4; max-width:70ch; }
.caption[hidden]{ display:block; visibility:hidden; }
.bar{ display:flex; flex-wrap:wrap; align-items:center; gap:10px; }
button{ font:inherit; font-weight:700; font-size:1rem; color:var(--ink); background:var(--panel); border:2px solid var(--ink); border-radius:999px; padding:8px 16px; cursor:pointer; min-height:44px; }
button:hover{ background:var(--line); }
button:focus-visible, input:focus-visible{ outline:3px solid var(--accent); outline-offset:2px; }
button.play{ background:var(--ink); color:var(--page); min-width:96px; }
.count{ margin-left:auto; color:var(--muted); font-size:1rem; font-variant-numeric:tabular-nums; }
.opts{ display:flex; flex-wrap:wrap; gap:18px; margin-top:14px; color:var(--muted); }
label{ display:flex; align-items:center; gap:8px; cursor:pointer; }
input[type=checkbox]{ width:20px; height:20px; accent-color:var(--accent); }
.scrub{ display:flex; gap:4px; margin:12px 0 0; }
.scrub span{ flex:1; height:8px; border-radius:4px; background:var(--line); cursor:pointer; }
.scrub span.on{ background:var(--ink); }
.scrub span.done{ background:var(--muted); }
@media (max-width:600px){ .count{ margin-left:0; width:100%; } }
</style>
</head>
<body>
<main>
  <h1>Firsts, drawn in code</h1>
  <p class="sub">The opening grid and the first six items: the balloon, the railway, the parachute, the car, the plane and the core. Every panel is brush strokes written in JavaScript — no images. Play it through, or step one panel at a time.</p>
  <div class="stage"><canvas id="cv" width="1920" height="1080" aria-label="Current panel"></canvas></div>
  <p class="caption" id="cap" aria-live="polite"></p>
  <div class="bar">
    <button id="prev" aria-label="Previous panel">Back</button>
    <button id="play" class="play">Play</button>
    <button id="next" aria-label="Next panel">Next</button>
    <button id="restart">Start over</button>
    <span class="count" id="count"></span>
  </div>
  <div class="scrub" id="scrub" aria-hidden="true"></div>
  <div class="opts">
    <label><input type="checkbox" id="optCap" checked> Show narration</label>
    <label><input type="checkbox" id="optBoil"> Hand-drawn wobble</label>
    <label><input type="checkbox" id="optPush" checked> Slow push-in on key panels</label>
  </div>
